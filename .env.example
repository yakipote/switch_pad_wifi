# .env.example → .env にコピーして、自分の環境に合わせて書き換える（.env は git に入らない）
# make / switchpad.ps1 が読み込んで、常駐サーバーに渡す。
# ESP32 のトークンは書かなくてよい（常駐サーバーが config.h の API_TOKEN を読む）

# ESP32 のアドレス。switchpad.local（mDNS）は Python から引けないことが多いので IP がおすすめ。
# ルーターで ESP32 の IP を固定しておくと楽
SWITCHPAD_URL=http://192.168.1.50

# キャプチャーボードの名前の一部（make probe で一覧が出る）
CAPTURE_NAME=GC311

# make voice で使う VOICEVOX のイメージ（cpu / gpu）
VOICEVOX=cpu

# 常駐サーバーのポート（ライブ表示と MCP の /mcp）
CAPTURE_SHARE_PORT=8765
